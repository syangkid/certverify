<%- include('../partials/head', { title: 'Student Dashboard' }) %>
<%- include('../partials/header') %>

<main class="container">
  <h1>Student Dashboard</h1>
  <p class="hint">Welcome, <%= user.name %>. These are your academic certificates.</p>

  <div class="stats">
    <div class="stat"><span class="stat-number"><%= stats.active_certificates %></span><span class="stat-label">Active certificates</span></div>
    <div class="stat"><span class="stat-number"><%= stats.revoked_certificates %></span><span class="stat-label">Revoked certificates</span></div>
  </div>

  <div class="actions">
    <a class="btn btn-primary" href="/student/certificates">View my certificates</a>
    <a class="btn btn-secondary" href="/verify">Verify a certificate</a>
  </div>
</main>

<%- include('../partials/footer') %>
