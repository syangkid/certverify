<%- include('../partials/head', { title: 'Institution Dashboard' }) %>
<%- include('../partials/header') %>

<main class="container">
  <h1>Institution Staff Dashboard</h1>
  <p class="hint">Welcome, <%= user.name %>.
    <% if (stats.institution_name) { %>You manage <strong><%= stats.institution_name %></strong>.<% } %>
  </p>

  <div class="stats">
    <div class="stat"><span class="stat-number"><%= stats.students %></span><span class="stat-label">Students</span></div>
    <div class="stat"><span class="stat-number"><%= stats.active_certificates %></span><span class="stat-label">Active certificates</span></div>
    <div class="stat"><span class="stat-number"><%= stats.revoked_certificates %></span><span class="stat-label">Revoked certificates</span></div>
    <div class="stat"><span class="stat-number"><%= stats.verifications %></span><span class="stat-label">Times your certificates were checked</span></div>
  </div>

  <div class="actions">
    <a class="btn btn-primary" href="/institution/students">Register a student</a>
    <a class="btn btn-primary" href="/institution/certificates">Issue a certificate</a>
    <a class="btn btn-secondary" href="/verify/history">Verification history</a>
    <a class="btn btn-secondary" href="/verify">Verify a certificate</a>
  </div>
</main>

<%- include('../partials/footer') %>
