<%- include('../partials/head', { title: 'Verifier Dashboard' }) %>
<%- include('../partials/header') %>

<main class="container">
  <h1>Verifier Dashboard</h1>
  <p class="hint">Welcome, <%= user.name %>. Checks you make while logged in are saved to your history.</p>

  <div class="stats">
    <div class="stat"><span class="stat-number"><%= stats.total %></span><span class="stat-label">Total checks</span></div>
    <div class="stat"><span class="stat-number"><%= stats.valid %></span><span class="stat-label">Valid</span></div>
    <div class="stat"><span class="stat-number"><%= stats.revoked %></span><span class="stat-label">Revoked</span></div>
    <div class="stat"><span class="stat-number"><%= stats.not_found %></span><span class="stat-label">Not found</span></div>
    <div class="stat"><span class="stat-number"><%= stats.invalid %></span><span class="stat-label">Invalid codes</span></div>
  </div>

  <div class="actions">
    <a class="btn btn-primary" href="/verify">Verify a certificate</a>
    <a class="btn btn-secondary" href="/verify/history">My history</a>
  </div>
</main>

<%- include('../partials/footer') %>
